# Server
PORT=4000
NODE_ENV=development

# Frontend origin allowed to call this API with credentials (cookies)
APP_URL=http://localhost:3000

# Postgres (Supabase) - Project Settings -> Database -> Connection string
# (use the "Transaction" pooler connection string for serverless-friendly
# pooling; either works for local dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Auth
JWT_SECRET=dev_change_me
JWT_EXPIRES_IN=7d
COOKIE_NAME=token
ADMIN_COOKIE_NAME=admin_token

# Signs the unsubscribe links embedded in emails (separate secret from
# JWT_SECRET so rotating one doesn't invalidate the other's tokens)
LINK_SECRET=dev_change_me_too

# Shared secret between kickDrain() and netlify/functions/drain.js - only
# needed when deployed on Netlify (see docs/netlify-deploy.md). Unused/unset
# locally: server.js drains the run queue in-process on an interval instead.
INTERNAL_DRAIN_SECRET=

# Admin - the only account that can log in (realtors are onboarded by Admin
# and never log in themselves). Seed/update with:
#   node scripts/seedAdmin.mjs
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
ADMIN_NAME=Admin

# Spreadsheet ingestion
SHEET_FETCHER=local             # local | http - local reads data/fixtures/, http fetches real Google Sheets
SPREADSHEET_FIXTURES_DIR=../../data/fixtures

# Listings
LISTINGS_PROVIDER=mock          # mock | zillow
# data/listings.json is the small curated fixture the unit test suite
# asserts against (exact ZIPs and counts) - don't repoint this at
# data/listings-real.json (328 real Bronx listings) unless you're manually
# testing, or `npm test` will fail.
MOCK_LISTINGS_PATH=../../data/listings.json
ZILLOW_API_KEY=

# Email
MAIL_TRANSPORT=smtp             # smtp | mock (mock pushes to an in-memory array, used in tests)

# --- Option A: local dev, MailDev catch-all (npm run maildev, UI at :1080) ---
# Never reaches a real inbox - inspect sends at http://localhost:1080 instead.
# SMTP_HOST=localhost
# SMTP_PORT=1025

# --- Option B: Resend (real delivery) ---
# Get an API key at https://resend.com/api-keys. Until you verify your own
# sending domain there, MAIL_FROM must stay onboarding@resend.dev, and Resend
# will only actually deliver to the email address on your own Resend account -
# fine for testing the pipe, not for real buyers yet.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key_here

MAIL_FROM="Listing Bot <onboarding@resend.dev>"
